# Enable after the central API URL and Device Key have been configured.
UPLOAD_ENABLED=false

RECORDING_ROOT=/var/lib/mediamtx/recordings
RETRY_DELAY_SECONDS=15

# Delete the local MP4 only after the presigned upload and backend completion
# update have both succeeded.
DELETE_LOCAL_AFTER_UPLOAD=true

# The backend issues a short-lived upload URL for each recording. Pi 5 does not
# store MinIO credentials or a MinIO endpoint.
CENTRAL_API_ENABLED=false
CENTRAL_API_BASE_URL=https://CENTRAL_API_HOST
CENTRAL_API_DEVICE_KEY=

# Report camera and local LL-HLS health every 10 seconds. Two consecutive
# failures confirm an ERROR before the backend's 30-second heartbeat timeout.
CAMERA_HEARTBEAT_INTERVAL_SECONDS=10
CAMERA_HEARTBEAT_FAILURE_THRESHOLD=2
CAMERA_HEARTBEAT_RECOVERY_THRESHOLD=1
CAMERA_HEARTBEAT_CAMERA_CODES="camera-01 camera-02 camera-03 camera-04"
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_API_USER=localadmin
# Must match the localadmin password in /etc/mediamtx/mediamtx.yml.
MEDIAMTX_API_PASSWORD=

# Local LL-HLS health check. The password must match the webviewer account in
# /etc/mediamtx/mediamtx.yml. These credentials never leave Pi 5.
HLS_HEALTH_BASE_URL=http://127.0.0.1:8888
HLS_HEALTH_USER=webviewer
HLS_HEALTH_PASSWORD=
HLS_HEALTH_TIMEOUT_SECONDS=5
