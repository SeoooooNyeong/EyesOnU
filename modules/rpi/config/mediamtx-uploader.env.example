# Enable only after all MinIO values below have been configured on the Pi 5.
UPLOAD_ENABLED=false

# MinIO API endpoint. Do not use the web-console port and do not add a trailing slash.
MINIO_ENDPOINT=http://xxx.xxx.xxx.xxx:xxxx
MINIO_BUCKET=cctv
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Object Key format:
# {MINIO_OBJECT_PREFIX}/{MEDIA_SERVER_ID}/{cameraPath}/{YYYY}/{MM}/{DD}/{file}.mp4
MINIO_OBJECT_PREFIX=recordings
MEDIA_SERVER_ID=rpi5-media-01

# Set true only for a development MinIO server with a self-signed HTTPS certificate.
MINIO_INSECURE=false

RECORDING_ROOT=/var/lib/mediamtx/recordings
RETRY_DELAY_SECONDS=15

# Delete the local MP4 only after MinIO confirms the upload.
DELETE_LOCAL_AFTER_UPLOAD=true
