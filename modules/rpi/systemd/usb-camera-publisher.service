[Unit]
Description=Raspberry Pi USB webcam RTSP publisher
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__RUN_USER__
SupplementaryGroups=video
EnvironmentFile=/etc/default/usb-camera-publisher
ExecStart=/usr/local/bin/publish-rpi4-usb-camera ${MEDIA_SERVER_HOST} ${CAMERA_ID} ${VIDEO_DEVICE}
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
