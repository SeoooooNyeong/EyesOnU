pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        DEPLOY_COMPOSE = 'infra/compose.deploy.yml'
        DEPLOY_ENV_FILE = '/run/secrets/eyesonu-deploy.env'
        DEPLOY_SSH_HOST = '127.0.0.1'
        DEPLOY_SSH_USER = 'ubuntu'
        DEPLOY_HOST_ROOT = '/home/ubuntu/jenkins-data/workspace/ssafy-a204-infra'
        DEPLOY_HOST_ENV_FILE = '/home/ubuntu/S15P11A204/infra/.env.deploy'
        // Let Testcontainers' cleanup sidecar remove orphaned test containers
        // when a build is interrupted or the test JVM exits unexpectedly.
        TESTCONTAINERS_RYUK_DISABLED = 'false'
        TESTCONTAINERS_HOST_OVERRIDE = '127.0.0.1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Detect relevant changes') {
            steps {
                script {
                    def changedFiles = []
                    currentBuild.changeSets.each { changeSet ->
                        changeSet.items.each { change ->
                            change.affectedFiles.each { file -> changedFiles << file.path }
                        }
                    }
                    if (changedFiles.isEmpty()) {
                        changedFiles = sh(
                            script: "git diff --name-only HEAD^ HEAD 2>/dev/null || git show --pretty='' --name-only HEAD",
                            returnStdout: true
                        ).trim().readLines()
                    }
                    changedFiles = changedFiles.unique()
                    def backendChange = changedFiles.any { path -> path.startsWith('apps/backend-api/eyesonu/') }
                    def adminChange = changedFiles.any { path -> path.startsWith('apps/frontend/admin-dashboard/') }
                    def reporterChange = changedFiles.any { path -> path.startsWith('apps/frontend/reporter-webapp/') }
                    def infraChange = changedFiles.any { path -> path.startsWith('infra/') }
                    def relevantChange = backendChange || adminChange || reporterChange || infraChange
                    def deployServices = []

                    if (backendChange || infraChange) {
                        deployServices << 'backend'
                    }
                    if (adminChange || infraChange) {
                        deployServices << 'admin'
                    }
                    if (reporterChange || infraChange) {
                        deployServices << 'reporter'
                    }

                    env.RELEVANT_CHANGE = relevantChange ? 'true' : 'false'
                    env.BACKEND_CHANGE = backendChange ? 'true' : 'false'
                    env.ADMIN_CHANGE = adminChange ? 'true' : 'false'
                    env.REPORTER_CHANGE = reporterChange ? 'true' : 'false'
                    env.INFRA_CHANGE = infraChange ? 'true' : 'false'
                    env.DEPLOY_SERVICES = deployServices.join(' ')
                    echo "Changed files: ${changedFiles.join(', ')}"
                    echo "Relevant CI/CD change: ${env.RELEVANT_CHANGE}"
                    echo "Services to deploy: ${env.DEPLOY_SERVICES ?: 'none'}"
                }
            }
        }

        stage('Resolve branch') {
            steps {
                script {
                    def rawBranch = env.gitlabTargetBranch ?: env.BRANCH_NAME ?: env.GIT_BRANCH ?: ''
                    def targetBranch = rawBranch.tokenize('/').last()
                    def mergeRequest = env.gitlabMergeRequestIid?.trim()

                    env.TARGET_BRANCH = targetBranch
                    env.DEPLOY_PROFILE = targetBranch in ['dev', 'master'] ? targetBranch : ''
                    env.CAN_DEPLOY = env.DEPLOY_PROFILE && !mergeRequest ? 'true' : 'false'

                    echo "Target branch: ${targetBranch}, merge request: ${mergeRequest ? 'yes' : 'no'}, deploy: ${env.CAN_DEPLOY}"
                }
            }
        }

        stage('Backend build and test') {
            when {
                anyOf {
                    expression { env.BACKEND_CHANGE == 'true' }
                    expression { env.INFRA_CHANGE == 'true' }
                }
            }
            steps {
                dir('apps/backend-api/eyesonu') {
                    sh './mvnw -B clean verify'
                }
            }
        }

        stage('Frontend build validation') {
            when {
                expression { env.RELEVANT_CHANGE == 'true' }
            }
            parallel {
                stage('Admin frontend') {
                    when {
                        anyOf {
                            expression { env.ADMIN_CHANGE == 'true' }
                            expression { env.INFRA_CHANGE == 'true' }
                        }
                    }
                    steps {
                        dir('apps/frontend/admin-dashboard') {
                            sh '''
                                IMAGE="eyesonu/admin-ci:${BUILD_NUMBER}"
                                docker build --tag "$IMAGE" .
                                docker image rm --force "$IMAGE" || true
                            '''
                        }
                    }
                }
                stage('Reporter frontend') {
                    when {
                        anyOf {
                            expression { env.REPORTER_CHANGE == 'true' }
                            expression { env.INFRA_CHANGE == 'true' }
                        }
                    }
                    steps {
                        dir('apps/frontend/reporter-webapp') {
                            sh '''
                                IMAGE="eyesonu/reporter-ci:${BUILD_NUMBER}"
                                docker build --tag "$IMAGE" .
                                docker image rm --force "$IMAGE" || true
                            '''
                        }
                    }
                }
            }
        }

        stage('Deploy to EC2 Docker Engine') {
            when {
                allOf {
                    expression { env.CAN_DEPLOY == 'true' }
                    expression { env.RELEVANT_CHANGE == 'true' }
                }
            }
            steps {
                sshagent(credentials: ['eyesonu-ec2-deploy-key']) {
                    sh '''
                        test -s "$HOME/.ssh/known_hosts" || {
                            echo "ERROR: Jenkins known_hosts is missing or empty: $HOME/.ssh/known_hosts" >&2
                            exit 1
                        }

                        ssh -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$HOME/.ssh/known_hosts" \
                          "$DEPLOY_SSH_USER@$DEPLOY_SSH_HOST" \
                          "test -f '$DEPLOY_HOST_ROOT/infra/scripts/deploy-on-host.sh' || { \
                               echo 'ERROR: deploy script is missing on the deployment host: $DEPLOY_HOST_ROOT/infra/scripts/deploy-on-host.sh' >&2; \
                               exit 1; \
                           }; \
                           echo 'Deployment host checkout:'; \
                           git -C '$DEPLOY_HOST_ROOT' rev-parse --short HEAD 2>/dev/null || echo unknown; \
                           DEPLOY_ROOT='$DEPLOY_HOST_ROOT' \
                           DEPLOY_ENV_FILE='$DEPLOY_HOST_ENV_FILE' \
                           DEPLOY_SERVICES='$DEPLOY_SERVICES' \
                           bash '$DEPLOY_HOST_ROOT/infra/scripts/deploy-on-host.sh' '$DEPLOY_PROFILE'"
                    '''
                }
            }
        }
    }

    post {
        success {
            script {
                def triggerType = env.gitlabActionType ?: (env.gitlabMergeRequestIid ? 'MERGE_REQUEST' : 'PUSH')
                def targetBranch = env.TARGET_BRANCH ?: 'unknown'
                def actor = env.gitlabUserEmail ?: env.gitlabUserName ?: 'Jenkins'
                def result = env.CAN_DEPLOY == 'true' ? '빌드·테스트·배포' : '빌드·테스트'

                mattermostSend color: '#00d1b2', message: """### ✅ Eyes On U CI/CD 성공
> **빌드 번호:** [#${env.BUILD_NUMBER}](${env.BUILD_URL})
> **트리거:** `${triggerType}`
> **대상 브랜치:** `${targetBranch}`
> **실행자:** `${actor}`
> **수행 결과:** ${result} 완료

파이프라인이 정상적으로 완료되었습니다.

🔎 [Jenkins에서 상세 로그 확인하기](${env.BUILD_URL})"""
            }
        }
        failure {
            script {
                def triggerType = env.gitlabActionType ?: (env.gitlabMergeRequestIid ? 'MERGE_REQUEST' : 'PUSH')
                def targetBranch = env.TARGET_BRANCH ?: 'unknown'
                def actor = env.gitlabUserEmail ?: env.gitlabUserName ?: 'Jenkins'

                mattermostSend color: '#ff3860', message: """### ❌ Eyes On U CI/CD 실패
> **빌드 번호:** [#${env.BUILD_NUMBER}](${env.BUILD_URL})
> **트리거:** `${triggerType}`
> **대상 브랜치:** `${targetBranch}`
> **실행자:** `${actor}`

파이프라인 실행 중 오류가 발생했습니다. Jenkins 로그를 확인해 주세요.

🔎 [Jenkins에서 오류 로그 확인하기](${env.BUILD_URL})"""
            }
        }
    }
}
