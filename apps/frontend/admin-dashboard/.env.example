# Backend origin used by the Vite development proxy.
VITE_API_PROXY_TARGET=http://localhost:8080

# Optional MediaMTX transport origin. DB stream URL paths are rebased onto this origin.
VITE_MEDIA_STREAM_BASE_URL=http://70.12.108.93:8888
